# --- LLM: OpenCode Zen (OpenAI-compatible /chat/completions endpoint) ---
# Get a key at https://opencode.ai  (model IDs: https://opencode.ai/zen/v1/models)
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_TEMPERATURE=0.0

# --- Embeddings ---
# OpenCode Zen has no embeddings endpoint. Point this at any OpenAI-compatible
# embeddings server: local Ollama, OpenAI, TEI, etc.
#   Ollama:  ollama pull nomic-embed-text   (base url http://127.0.0.1:11434/v1, dim 768)
#   OpenAI:  base url https://api.openai.com/v1, model text-embedding-3-small, dim 1536
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# --- Database ---
POSTGRES_DB=bigtheta-db-posstgresql
POSTGRES_USER=lemon
POSTGRES_PASSWORD=lemon

# --- Vector store ---
VECTOR_STORE_TYPE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks

# --- RAG tuning ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
CHUNK_MIN_CHARS=40
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.2

# --- Uploads ---
UPLOAD_DIR=./data/uploads

# --- Server ---
SERVER_PORT=8080
